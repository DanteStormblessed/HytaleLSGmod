$C = "../Common.ui";

$C.@PageOverlay #MainPage {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    @CloseButton = true;
    Anchor: (Width: 750, Height: 510);

    #Title {
      $C.@Title {
        @Text = "LifeSync-Games - Panel Principal";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 18);

      Group #HeaderBar {
        Anchor: (Height: 28, Bottom: 10);
        LayoutMode: Left;

        Label #PlayerGreetingLabel {
          FlexWeight: 1;
          Text: "Jugador: Conectado";
          Style: (FontSize: 14, TextColor: #7de2d1, RenderBold: true, VerticalAlignment: Center);
        }

        Label #HeaderSubtitleLabel {
          Text: "Sincronizacion Multidimensional Activa";
          Style: (FontSize: 12, TextColor: #77879d, VerticalAlignment: Center);
        }
      }

      $C.@ContentSeparator {
        @Anchor = (Bottom: 10);
      }

      Group #TabsBar {
        Anchor: (Height: 36, Bottom: 12);
        LayoutMode: Left;

        $C.@TextButton #TabRewardsButton {
          @Anchor = (Right: 10);
          Anchor: (Width: 210, Height: 34);
          Text: "Canjear Recompensas";
        }

        $C.@SecondaryTextButton #TabProfileButton {
          Anchor: (Width: 230, Height: 34);
          Text: "Perfil Multidimensional";
        }
      }

      Group #ContentArea {
        LayoutMode: Top;
        Anchor: (Height: 350);

        // ==========================================
        // TAB 1: RECOMPENSAS
        // ==========================================
        Group #TabRewardsContent {
          LayoutMode: Top;
          Anchor: (Full: 0);

          Label #RewardsIntroLabel {
            Anchor: (Height: 20, Bottom: 8);
            Text: "Canjea tus puntos ganados por habitos reales por pociones especiales:";
            Style: (FontSize: 13, TextColor: #afc2c3);
          }

          // Card Stamina
          Group #RewardCardStamina {
            Anchor: (Height: 84, Bottom: 8);
            Background: #151e28;
            Padding: (Full: 8);
            LayoutMode: Left;

            Group #StaminaIconBox {
              Anchor: (Width: 64, Height: 68, Right: 12);
              Background: #1d2b3a;
              Padding: (Full: 4);

              Group {
                Background: (TexturePath: "Common/Icons/ItemsGenerated/Potion_Stamina_Custom.png");
              }
            }

            Group #StaminaInfoBox {
              FlexWeight: 1;
              LayoutMode: Top;
              Padding: (Top: 2);

              Label {
                Anchor: (Height: 20);
                Text: "Pocion de Stamina Infinita (10s)";
                Style: (FontSize: 14, TextColor: #ffcc00, RenderBold: true);
              }

              Label {
                Anchor: (Height: 18);
                Text: "Otorga regeneracion maxima y continua de stamina.";
                Style: (FontSize: 12, TextColor: #96a9be);
              }

              Label #StaminaCostLabel {
                Anchor: (Height: 18);
                Text: "Costo: 50 Puntos (Dimension Fisica)";
                Style: (FontSize: 12, TextColor: #55ff99, RenderBold: true);
              }
            }

            $C.@TextButton #RedeemStaminaButton {
              Anchor: (Width: 140, Height: 36, Left: 10);
              Text: "Canjear";
            }
          }

          // Card Health
          Group #RewardCardHealth {
            Anchor: (Height: 84, Bottom: 8);
            Background: #151e28;
            Padding: (Full: 8);
            LayoutMode: Left;

            Group #HealthIconBox {
              Anchor: (Width: 64, Height: 68, Right: 12);
              Background: #1d2b3a;
              Padding: (Full: 4);

              Group {
                Background: (TexturePath: "Common/Icons/ItemsGenerated/Potion_Health_Custom.png");
              }
            }

            Group #HealthInfoBox {
              FlexWeight: 1;
              LayoutMode: Top;
              Padding: (Top: 2);

              Label {
                Anchor: (Height: 20);
                Text: "Pocion de Vida Infinita (10s)";
                Style: (FontSize: 14, TextColor: #ff5555, RenderBold: true);
              }

              Label {
                Anchor: (Height: 18);
                Text: "Otorga invulnerabilidad absoluta y salud infinita.";
                Style: (FontSize: 12, TextColor: #96a9be);
              }

              Label #HealthCostLabel {
                Anchor: (Height: 18);
                Text: "Costo: 75 Puntos (Dimension Fisica)";
                Style: (FontSize: 12, TextColor: #55ff99, RenderBold: true);
              }
            }

            $C.@TextButton #RedeemHealthButton {
              Anchor: (Width: 140, Height: 36, Left: 10);
              Text: "Canjear";
            }
          }

          // Card Mana
          Group #RewardCardMana {
            Anchor: (Height: 84, Bottom: 8);
            Background: #151e28;
            Padding: (Full: 8);
            LayoutMode: Left;

            Group #ManaIconBox {
              Anchor: (Width: 64, Height: 68, Right: 12);
              Background: #1d2b3a;
              Padding: (Full: 4);

              Group {
                Background: (TexturePath: "Common/Icons/ItemsGenerated/Potion_Mana_Custom.png");
              }
            }

            Group #ManaInfoBox {
              FlexWeight: 1;
              LayoutMode: Top;
              Padding: (Top: 2);

              Label {
                Anchor: (Height: 20);
                Text: "Pocion de Mana Infinito (10s)";
                Style: (FontSize: 14, TextColor: #4efaff, RenderBold: true);
              }

              Label {
                Anchor: (Height: 18);
                Text: "Mantiene tu energia de mana al maximo sin limites.";
                Style: (FontSize: 12, TextColor: #96a9be);
              }

              Label #ManaCostLabel {
                Anchor: (Height: 18);
                Text: "Costo: 50 Puntos (Dimension Mental)";
                Style: (FontSize: 12, TextColor: #55ff99, RenderBold: true);
              }
            }

            $C.@TextButton #RedeemManaButton {
              Anchor: (Width: 140, Height: 36, Left: 10);
              Text: "Canjear";
            }
          }

          Label #RewardStatusLabel {
            Anchor: (Height: 20);
            Text: "";
            Style: (FontSize: 12, TextColor: #e8a93b, HorizontalAlignment: Center);
          }
        }

        // ==========================================
        // TAB 2: PERFIL MULTIDIMENSIONAL
        // ==========================================
        Group #TabProfileContent {
          LayoutMode: Top;
          Anchor: (Full: 0);
          Visible: false;

          Label #ProfileIntroLabel {
            Anchor: (Height: 20, Bottom: 8);
            Text: "Visualizacion de puntos acumulados por cada dimension humana:";
            Style: (FontSize: 13, TextColor: #afc2c3);
          }

          Group #ProfileRow1 {
            Anchor: (Height: 110, Bottom: 8);
            LayoutMode: Left;

            Group #CardDimFisica {
              FlexWeight: 1;
              Anchor: (Right: 5);
              Background: #151e28;
              Padding: (Full: 10);
              LayoutMode: Top;

              Label {
                Anchor: (Height: 20);
                Text: "Dimension Fisica";
                Style: (FontSize: 14, TextColor: #ffaa00, RenderBold: true);
              }

              Label #FisicoPointsLabel {
                Anchor: (Height: 26, Top: 2);
                Text: "Cargando...";
                Style: (FontSize: 18, TextColor: #55ff99, RenderBold: true);
              }

              Label {
                Anchor: (Height: 34, Top: 2);
                Text: "Puntos por pasos, actividad fisica y entrenamiento.";
                Style: (FontSize: 11, TextColor: #8397ab, Wrap: true);
              }
            }

            Group #CardDimMental {
              FlexWeight: 1;
              Anchor: (Left: 5);
              Background: #151e28;
              Padding: (Full: 10);
              LayoutMode: Top;

              Label {
                Anchor: (Height: 20);
                Text: "Dimension Mental";
                Style: (FontSize: 14, TextColor: #00d4ff, RenderBold: true);
              }

              Label #MentalPointsLabel {
                Anchor: (Height: 26, Top: 2);
                Text: "Cargando...";
                Style: (FontSize: 18, TextColor: #55ff99, RenderBold: true);
              }

              Label {
                Anchor: (Height: 34, Top: 2);
                Text: "Puntos por sesiones de estudio, lectura y foco mental.";
                Style: (FontSize: 11, TextColor: #8397ab, Wrap: true);
              }
            }
          }

          Group #ProfileRow2 {
            Anchor: (Height: 110, Bottom: 8);
            LayoutMode: Left;

            Group #CardDimSocial {
              FlexWeight: 1;
              Anchor: (Right: 5);
              Background: #151e28;
              Padding: (Full: 10);
              LayoutMode: Top;

              Label {
                Anchor: (Height: 20);
                Text: "Dimension Social";
                Style: (FontSize: 14, TextColor: #55ff77, RenderBold: true);
              }

              Label #SocialPointsLabel {
                Anchor: (Height: 26, Top: 2);
                Text: "Cargando...";
                Style: (FontSize: 18, TextColor: #55ff99, RenderBold: true);
              }

              Label {
                Anchor: (Height: 34, Top: 2);
                Text: "Puntos por participacion comunitaria y cooperacion grupal.";
                Style: (FontSize: 11, TextColor: #8397ab, Wrap: true);
              }
            }

            Group #CardDimAfectiva {
              FlexWeight: 1;
              Anchor: (Left: 5);
              Background: #151e28;
              Padding: (Full: 10);
              LayoutMode: Top;

              Label {
                Anchor: (Height: 20);
                Text: "Dimension Afectiva";
                Style: (FontSize: 14, TextColor: #ff55aa, RenderBold: true);
              }

              Label #AfectivoPointsLabel {
                Anchor: (Height: 26, Top: 2);
                Text: "Cargando...";
                Style: (FontSize: 18, TextColor: #55ff99, RenderBold: true);
              }

              Label {
                Anchor: (Height: 34, Top: 2);
                Text: "Puntos por descanso reparador, meditacion y bienestar.";
                Style: (FontSize: 11, TextColor: #8397ab, Wrap: true);
              }
            }
          }

          Group #ProfileBottomRow {
            Anchor: (Height: 36);
            LayoutMode: Left;

            $C.@SecondaryTextButton #RefreshProfileButton {
              Anchor: (Width: 220, Height: 36);
              Text: "Actualizar Puntos";
            }

            Label #ProfileStatusLabel {
              FlexWeight: 1;
              Anchor: (Left: 12);
              Text: "";
              Style: (FontSize: 12, TextColor: #e8a93b, VerticalAlignment: Center);
            }
          }
        }
      }
    }
  }
}
